YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=deepseek-v4.1-flash
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Optional local modes; compose enables the extended synthetic catalog by default
TN_EXTENDED_DEMO=1
TN_SEASONALITY_PROVIDER=openmeteo
# Structured audit logs include user text by default. Set to 0 to redact it.
TN_LOG_USER_MESSAGES=1
