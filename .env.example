YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=deepseek-v4.1-flash
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Локальные режимы; Compose включает расширенный каталог по умолчанию.
TN_EXTENDED_DEMO=1
TN_SEASONALITY_PROVIDER=openmeteo
# Установите 0, чтобы скрыть текст пользователя в структурированных логах.
TN_LOG_USER_MESSAGES=1
